<Window x:Class="TwitchDownloaderWPF.DanmakuBadgeColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Per-badge highlight colors" Width="400" SizeToContent="Height" MinWidth="340"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnOk" Content="OK" MinWidth="70" Click="BtnOk_Click" Background="{DynamicResource ActionButtonBackground}" Foreground="{DynamicResource ActionButtonText}" BorderBrush="{DynamicResource ActionButtonBorder}"/>
            <Button x:Name="btnCancel" Content="Cancel" MinWidth="70" Margin="8,0,0,0" Click="BtnCancel_Click" Background="{DynamicResource ActionButtonBackground}" Foreground="{DynamicResource ActionButtonText}" BorderBrush="{DynamicResource ActionButtonBorder}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Checked badges are highlighted with their own color. A comment with several checked badges uses the first matching row (top = highest priority). User-list matches keep the user highlight color." TextWrapping="Wrap" Foreground="{DynamicResource AppInnerText}" Margin="0,0,0,8"/>
            <StackPanel x:Name="rowsPanel"/>
        </StackPanel>
    </DockPanel>
</Window>
